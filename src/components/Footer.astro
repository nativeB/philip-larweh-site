---
import site from '../data/site.json';
import { waLink, telLink } from '../lib/whatsapp';
import { pagesByKind, pageUrl } from '../lib/pages';
const year = new Date().getFullYear();
const [services, materials, areas, guides] = await Promise.all(['service', 'material', 'area', 'guide'].map((k) => pagesByKind(k as never)));
const cols: [string, [string, string][]][] = [
  ['Services', services.map((p) => [pageUrl(p.id), p.data.label])],
  ['Materials for hire', [['/materials/', 'All materials'], ...materials.map((p): [string, string] => [pageUrl(p.id), p.data.label])]],
  ['Areas', [...areas.map((p): [string, string] => [pageUrl(p.id), p.data.label]), ['/areas/', 'Across Ghana']]],
  ['Guides', guides.map((p) => [pageUrl(p.id), p.data.label])],
];
---
<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-cols" aria-label="Footer">
      {cols.map(([title, links]) => (
        <div>
          <h2>{title}</h2>
          <ul>{links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
    <p style="margin:0"><strong>{site.name}</strong>: {site.tagline.toLowerCase()}, and {site.deckingTerm} materials for hire.</p>
    <p style="margin:0">Based in {site.baseLocation}. {site.serviceArea}</p>
    <p style="margin:0">
      <a href={waLink()} data-track="whatsapp" data-track-context="footer">WhatsApp</a> ·
      <a href={telLink} data-track="call" data-track-context="footer">{site.phoneDisplay}</a>
      {site.jijiUrl && <> · <a href={site.jijiUrl} target="_blank" rel="noopener" data-track="jiji">Jiji</a></>}
      {site.social.map((s: { label: string; url: string }) => <> · <a href={s.url} target="_blank" rel="noopener">{s.label}</a></>)}
    </p>
    <p style="margin:0">© {year} {site.name}</p>
  </div>
</footer>
